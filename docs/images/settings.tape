# Shared by every tape in tapes/ (Source docs/images/settings.tape). The
# tapes run from the repository root with the kmd under test in PATH:
# scripts/docs-images.sh.
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 15
Set Width 960
Set Height 600
Set Padding 24
Set Margin 0
Set TypingSpeed 40ms
Set Theme "TokyoNight"
